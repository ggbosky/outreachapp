# ─── Databáze (Supabase → Project Settings → Database → Connection string) ───
# Pooler (transaction mode, port 6543) – pro běh aplikace
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Přímé spojení (port 5432) – pro migrace (prisma db push / migrate)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ─── AI (Anthropic) ───
ANTHROPIC_API_KEY=""
# Claude 3.5 Sonnet je už vyřazený – výchozí je aktuální Sonnet
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Při odmítnutí požadavku zkusí server automaticky záložní model (jen přímé Claude API)
ANTHROPIC_FALLBACKS="true"

# ─── SMTP (odesílání) – Gmail: smtp.gmail.com, 465, App Password ───
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="ty@firma.cz"
SMTP_PASS=""
SMTP_FROM="Jan Novák <ty@firma.cz>"
# Náhodný rozestup mezi e-maily (sekundy) a denní limit – ochrana před spamem
EMAIL_DELAY_MIN_SECONDS="90"
EMAIL_DELAY_MAX_SECONDS="240"
EMAIL_DAILY_LIMIT="40"
# Text na konec každého e-mailu (např. možnost odhlášení)
EMAIL_FOOTER="Pokud o další zprávy nemáte zájem, stačí odepsat „ne“ a už se neozvu."

# ─── IMAP (čtení odpovědí) – výchozí přihlášení = SMTP_USER / SMTP_PASS ───
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASS=""
IMAP_LOOKBACK_DAYS="14"
WORKER_INTERVAL_SECONDS="300"

# ─── Vyhledávání firem (volitelné, bezplatné tarify) ───
# Google Programmable Search: https://programmablesearchengine.google.com (100 dotazů/den zdarma)
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""
# Brave Search API: https://brave.com/search/api (bezplatný tarif)
BRAVE_API_KEY=""

# ─── Scraper ───
SCRAPER_HEADLESS="true"
SCRAPER_MAX_PAGES="6"
SCRAPER_MAX_CONTENT_CHARS="40000"
SCRAPER_CONCURRENCY="3"
SCRAPER_REQUEST_DELAY_MS="800"
# Cesta k vlastnímu Chromiu (jinak se použije `npm run playwright:install`)
PLAYWRIGHT_CHROMIUM_PATH=""

# ─── Přístup ───
# Heslo pro vstup do aplikace (povinné, když běží na internetu)
APP_PASSWORD=""
